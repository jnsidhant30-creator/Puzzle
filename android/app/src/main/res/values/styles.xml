<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">#142331</item>
        <item name="colorPrimaryDark">#142331</item>
        <item name="colorAccent">#2EC4B6</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#142331</item>
        <item name="android:statusBarColor">#142331</item>
        <item name="android:navigationBarColor">#142331</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">#142331</item>
        <item name="colorPrimaryDark">#142331</item>
        <item name="colorAccent">#2EC4B6</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">#142331</item>
        <item name="android:statusBarColor">#142331</item>
        <item name="android:navigationBarColor">#142331</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="windowSplashScreenBackground">#142331</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>