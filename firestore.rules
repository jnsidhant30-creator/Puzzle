rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'jambujain1975@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role != 'ADMIN' || request.auth.token.email == 'jambujain1975@gmail.com');
      allow update: if (isOwner(userId) && (
        // Non-admin user cannot escalate role to ADMIN
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdmin()) &&
        // Cannot change uid
        (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid) &&
        // Cannot change email
        (!('email' in request.resource.data) || request.resource.data.email == resource.data.email) &&
        // Single update XP cap
        (!('xp' in request.resource.data) || (request.resource.data.xp >= resource.data.xp && request.resource.data.xp <= resource.data.xp + 1000)) &&
        // Single update Coins cap
        (!('coins' in request.resource.data) || (request.resource.data.coins <= resource.data.coins + 500))
      )) || isAdmin();
      
      match /favorites/{gameId} {
        allow read, write: if isOwner(userId);
      }

      match /wall/{postId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated();
      }
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /socialFeed/{feedId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /kudosGifts/{kudosId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /userBlocks/{blockId} {
      allow read, write: if isAuthenticated();
    }

    match /userMutes/{muteId} {
      allow read, write: if isAuthenticated();
    }

    match /moderationActions/{actionId} {
      allow read, write: if isAdmin();
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if (isOwner(userId) || isAdmin()) && !('email' in request.resource.data);
    }
    
    match /friendRequests/{requestId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow read: if request.auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow update: if request.auth != null && (request.auth.uid == resource.data.receiverId || request.auth.uid == resource.data.senderId);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
    }
    
    match /dailyRewards/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId &&
        request.resource.data.streak >= 1 && request.resource.data.streak <= 7;
      allow update: if isOwner(userId) && request.resource.data.userId == userId && (
        request.resource.data.lastClaimDate != resource.data.lastClaimDate &&
        request.resource.data.streak >= 1 &&
        (request.resource.data.streak == 1 || request.resource.data.streak == resource.data.streak + 1)
      );
      allow delete: if isAdmin();
    }
    
    match /puzzles/{puzzleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gameSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /personalBestHistory/{pbId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 50000 &&
        request.resource.data.bestTime is int &&
        request.resource.data.bestTime >= 1 &&
        request.resource.data.bestTime <= 36000 &&
        request.resource.data.puzzleType is string &&
        request.resource.data.difficulty in ['easy', 'medium', 'hard'];
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.score is int &&
        request.resource.data.score >= resource.data.score &&
        request.resource.data.score <= 50000 &&
        request.resource.data.bestTime is int &&
        request.resource.data.bestTime >= 1 &&
        request.resource.data.bestTime <= 36000;
      allow delete: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /userAchievements/{userAchievementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
        request.resource.data.userId is string &&
        request.resource.data.type in ['friend', 'reward', 'achievement', 'challenge', 'pb', 'event', 'system'] &&
        (request.resource.data.type != 'system' || isAdmin()) &&
        (request.resource.data.type in ['friend', 'challenge'] || request.resource.data.userId == request.auth.uid || isAdmin()) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 100 &&
        request.resource.data.message is string && request.resource.data.message.size() <= 500 &&
        request.resource.data.isRead == false;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /friendChallenges/{challengeId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.creatorUid == request.auth.uid);
    }

    match /playerGoals/{goalId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /showcaseConfigs/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /puzzleCollections/{collectionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /userCollectionProgress/{progressId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /journeyProgress/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /masteryProgress/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /practiceProgress/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /puzzleGuides/{puzzleType} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /communityPuzzles/{puzzleId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }

      match /events/{eventId} {
        allow read: if true;
        allow write: if isAuthenticated();

        match /participants/{participantId} {
          allow read: if true;
          allow write: if isAuthenticated();
        }
      }

      match /milestones/{milestoneId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /discussions/{discussionId} {
        allow read: if true;
        allow write: if isAuthenticated();

        match /replies/{replyId} {
          allow read: if true;
          allow write: if isAuthenticated();
        }
      }

      match /guides/{guideId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    match /clubMembers/{memberId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /clubCompetitions/{competitionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clubScores/{scoreId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /clubDuels/{duelId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
