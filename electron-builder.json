{
  "appId": "com.puzzleverse.desktop",
  "productName": "PuzzleVerse",
  "copyright": "Copyright © 2026 Sidhant Jain / PuzzleVerse",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "npmRebuild": false,
  "files": [
    "dist/**/*",
    "electron/**/*",
    "build/icon.ico",
    "build/icon-256.png",
    "build/icon-512.png",
    "build/icons/**/*",
    "package.json",
    "!**/node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "portable",
        "arch": ["x64", "arm64"]
      }
    ],
    "signAndEditExecutable": true,
    "requestedExecutionLevel": "asInvoker",
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PuzzleVerse",
    "menuCategory": "Games",
    "runAfterFinish": true,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "installerHeader": "build/installerHeader.bmp",
    "installerSidebar": "build/installerSidebar.bmp",
    "uninstallDisplayName": "PuzzleVerse ${version}"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
  },
  "mac": {
    "category": "public.app-category.puzzle-games",
    "icon": "build/icon-512.png",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "electron/entitlements.mac.plist",
    "entitlementsInherit": "electron/entitlements.mac.plist",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64", "universal"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "dmg": {
    "title": "PuzzleVerse ${version}",
    "icon": "build/icon-512.png"
  },
  "linux": {
    "category": "Game;LogicGame;",
    "icon": "build/icons",
    "maintainer": "Sidhant Jain <jnsidhu30@gmail.com>",
    "synopsis": "Challenge Your Mind. Beat Your Best.",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "deb",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "rpm",
        "arch": ["x64", "arm64"]
      }
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "jnsidhant30-creator",
      "repo": "Puzzle",
      "releaseType": "release"
    }
  ]
}
